[Unit]
Description=Nightly notes-rag retrieval bench, pushed to the Pushgateway (bench/scheduled.sh)
Wants=network-online.target
After=network-online.target rag.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rag
ExecStart=/opt/rag/bench/scheduled.sh retrieve
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
